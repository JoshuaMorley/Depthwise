<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/map_background">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Crosshair-measure mode: fixed at the map centre; drag the map under it. -->
    <ImageView
        android:id="@+id/measureCrosshair"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/measure_crosshair"
        android:visibility="gone" />

    <!-- Controls; padded by system bar insets at runtime. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="76dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hud"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp">

                <!-- Instrument cells; MainActivity moves them into one row or a 2x2 grid. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                <LinearLayout
                    android:id="@+id/hudRow1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/hudSpeedBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HudLabel"
                            android:text="SOG" />

                        <TextView
                            android:id="@+id/hudSpeed"
                            style="@style/HudValue"
                            android:text="--" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hudCourseBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HudLabel"
                            android:text="COG" />

                        <TextView
                            android:id="@+id/hudCourse"
                            style="@style/HudValue"
                            android:text="--" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hudDepthBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HudLabel"
                            android:text="DEPTH" />

                        <TextView
                            android:id="@+id/hudDepth"
                            style="@style/HudValue"
                            android:text="--" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hudAccuracyBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HudLabel"
                            android:text="GPS" />

                        <TextView
                            android:id="@+id/hudAccuracy"
                            style="@style/HudValue"
                            android:text="--" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hudRow2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/warning"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/recording"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/warningText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Why there's no position, when there isn't a good GPS fix. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/gpsStatus"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:id="@+id/gpsStatusIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_gps_off"
                        app:tint="@color/warning_amber" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/gpsStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ocean_on_container"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/gpsStatusDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- What the app is busy loading, if it takes a moment. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loading"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorSize="16dp"
                        app:trackThickness="2dp" />

                    <TextView
                        android:id="@+id/loadingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/ocean_on_container"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Right-hand tool column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:padding="4dp">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnCharts"
                style="@style/ToolFab"
                android:contentDescription="@string/charts"
                app:srcCompat="@drawable/ic_layers" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnTracks"
                style="@style/ToolFab"
                android:contentDescription="@string/tracks"
                app:srcCompat="@drawable/ic_timeline" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMarks"
                style="@style/ToolFab"
                android:contentDescription="@string/marks"
                app:srcCompat="@drawable/ic_place" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMeasure"
                style="@style/ToolFab"
                android:contentDescription="@string/measure"
                app:srcCompat="@drawable/ic_straighten" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnSettings"
                style="@style/ToolFab"
                android:contentDescription="@string/settings"
                app:srcCompat="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Measure bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/measureBar"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="128dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/measureTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/measure_hint"
                        android:textColor="@color/ocean_on_container"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/measureDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/measureAdd"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="#E65100"
                    android:text="@string/add_point"
                    android:visibility="gone"
                    app:icon="@drawable/ic_add" />

                <ImageButton
                    android:id="@+id/measureUndo"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/undo"
                    android:src="@drawable/ic_undo" />

                <ImageButton
                    android:id="@+id/measureClose"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/done"
                    android:src="@drawable/ic_close" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:text="@string/record_track"
            app:backgroundTint="@color/white"
            app:icon="@drawable/ic_record"
            app:iconTint="@color/recording" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/my_location"
            app:backgroundTint="@color/white"
            app:srcCompat="@drawable/ic_my_location"
            app:tint="@color/ocean_primary" />
    </FrameLayout>
</FrameLayout>
