<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: the app's arrow with a repeating sonar ping while the chart loads. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="ping"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.72"
                android:scaleY="0.72">
                <path
                    android:name="ring"
                    android:pathData="M54,22 A32,32 0 1,1 53.99,22 Z"
                    android:strokeColor="#FFFFFF"
                    android:strokeWidth="2.5"
                    android:strokeAlpha="0.8" />
            </group>
            <!-- Arrow fits inside the ring's smallest size (radius 32 x 0.72 = 23). -->
            <group
                android:scaleX="1.4"
                android:scaleY="1.4"
                android:translateX="37.2"
                android:translateY="37.9">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M12,2L4.5,20.29l0.71,0.71L12,18l6.79,3 0.71,-0.71z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="ping">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="1400"
                    android:propertyName="scaleX"
                    android:repeatCount="infinite"
                    android:valueFrom="0.72"
                    android:valueTo="1.05"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:duration="1400"
                    android:propertyName="scaleY"
                    android:repeatCount="infinite"
                    android:valueFrom="0.72"
                    android:valueTo="1.05"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1400"
                android:propertyName="strokeAlpha"
                android:repeatCount="infinite"
                android:valueFrom="0.9"
                android:valueTo="0"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>
</animated-vector>
